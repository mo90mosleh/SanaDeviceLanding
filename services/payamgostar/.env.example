# SERVER ONLY. Do not prefix these with VITE_ or commit the filled file.
PAYAMGOSTAR_WSDL_URL=
PAYAMGOSTAR_ENDPOINT=
PAYAMGOSTAR_USERNAME=
PAYAMGOSTAR_PASSWORD=
PAYAMGOSTAR_CONTRACT_FILE=
# Obtain this syntax from the vendor's SearchForm docs/read-only verification.
# Must contain exactly one {subject}; no SQL/LINQ default is assumed.
PAYAMGOSTAR_SEARCH_QUERY_TEMPLATE=
# Verify the vendor's meaning of SearchForm.typeKey; do not assume it is the code.
PAYAMGOSTAR_SEARCH_TYPE_KEY=
PAYAMGOSTAR_SEARCH_QUERY_VERIFIED=false
PAYAMGOSTAR_ALLOW_HTTP=false
# Absolute path on a mounted, durable LOCAL disk. Never a container's writable layer.
SANA_DB_PATH=
# Preserve the existing production webhook destination here.
SANA_WEBHOOK_URL=
SANA_ALLOWED_ORIGIN=
SANA_INGEST_TOKEN=
SANA_BIND=127.0.0.1
PORT=8081
